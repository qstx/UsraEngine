# Keep the public checkout path aligned with CMake -S; source discovery must
# never silently mix CMake files from one engine and sources from another.
set(URSA_ENGINE_DIR "${URSA_SOURCE_ROOT}" CACHE PATH "Engine checkout directory; must match the CMake source directory")
set(URSA_PROJECT_DIR "" CACHE PATH "Optional project directory for the workspace, debugging, tests and packaging")

foreach(variable IN ITEMS URSA_ENGINE_DIR URSA_PROJECT_DIR)
  if("${${variable}}" STREQUAL "" AND variable STREQUAL "URSA_PROJECT_DIR")
    continue()
  endif()
  get_filename_component(path "${${variable}}" ABSOLUTE BASE_DIR "${URSA_SOURCE_ROOT}")
  cmake_path(NORMAL_PATH path)
  if(NOT IS_DIRECTORY "${path}")
    message(FATAL_ERROR "${variable} must point to an existing directory: ${path}")
  endif()
  get_property(description CACHE "${variable}" PROPERTY HELPSTRING)
  set(${variable} "${path}")
  set(${variable} "${path}" CACHE PATH "${description}" FORCE)
endforeach()
file(REAL_PATH "${URSA_ENGINE_DIR}" enginePath)
file(REAL_PATH "${URSA_SOURCE_ROOT}" sourcePath)
if(WIN32)
  string(TOLOWER "${enginePath}" enginePath)
  string(TOLOWER "${sourcePath}" sourcePath)
endif()
if(NOT enginePath STREQUAL sourcePath)
  message(FATAL_ERROR "URSA_ENGINE_DIR must match the CMake source directory. Configure with -S \"${URSA_ENGINE_DIR}\" and -DURSA_ENGINE_DIR=\"${URSA_ENGINE_DIR}\".")
endif()
if(NOT URSA_PROJECT_DIR STREQUAL "" AND NOT IS_DIRECTORY "${URSA_PROJECT_DIR}/Assets")
  message(FATAL_ERROR "URSA_PROJECT_DIR must point to a project with an Assets directory: ${URSA_PROJECT_DIR}")
endif()
