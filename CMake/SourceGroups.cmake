function(ursa_collect_sources output)
  set(collected)
  foreach(directory IN LISTS ARGN)
    file(GLOB_RECURSE sources CONFIGURE_DEPENDS
      "${directory}/*.cpp" "${directory}/*.hpp" "${directory}/*.h" "${directory}/*.inl")
    list(APPEND collected ${sources})
  endforeach()
  list(REMOVE_DUPLICATES collected)
  set(${output} ${collected} PARENT_SCOPE)
endfunction()

function(ursa_source_groups target folder)
  set_target_properties(${target} PROPERTIES FOLDER "${folder}")
  set_property(GLOBAL APPEND PROPERTY URSA_GROUPED_TARGETS ${target})
  get_target_property(sources ${target} SOURCES)
  set(grouped)
  foreach(source IN LISTS sources)
    if(source MATCHES "^\$<")
      continue()
    endif()
    get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(absolute MATCHES "^${URSA_SOURCE_ROOT}/" AND NOT absolute MATCHES "/ThirdParty/")
      list(APPEND grouped "${absolute}")
    endif()
  endforeach()
  source_group(TREE "${URSA_SOURCE_ROOT}" FILES ${grouped})
endfunction()

function(ursa_write_project_manifest)
  get_property(targets GLOBAL PROPERTY URSA_GROUPED_TARGETS)
  list(REMOVE_DUPLICATES targets)
  set(document "{\"targets\":[")
  set(separator "")
  foreach(target IN LISTS targets)
    get_target_property(folder ${target} FOLDER)
    string(APPEND document "${separator}{\"name\":\"${target}\",\"folder\":\"${folder}\"}")
    set(separator ",")
  endforeach()
  string(APPEND document "]}\n")
  file(WRITE "${URSA_BINARY_ROOT}/UrsaProjectStructure.json" "${document}")
endfunction()
