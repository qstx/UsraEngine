# Publish has Release optimization, but never includes development instrumentation.
if(CMAKE_CONFIGURATION_TYPES)
  set(CMAKE_CONFIGURATION_TYPES "Debug;Release;Publish" CACHE STRING "Ursa build configurations" FORCE)
elseif(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Debug CACHE STRING "Ursa build configuration" FORCE)
endif()
if(NOT CMAKE_CONFIGURATION_TYPES)
  set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS Debug Release Publish)
endif()
if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE MATCHES "^(Debug|Release|Publish)$")
  message(FATAL_ERROR "Ursa configuration must be Debug, Release or Publish")
endif()
foreach(language IN ITEMS C CXX)
  if(NOT DEFINED CMAKE_${language}_FLAGS_RELEASE)
    set(CMAKE_${language}_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE}")
  endif()
  set(CMAKE_${language}_FLAGS_PUBLISH "${CMAKE_${language}_FLAGS_RELEASE}" CACHE STRING "Publish compiler flags" FORCE)
endforeach()
foreach(kind IN ITEMS EXE SHARED MODULE STATIC)
  set(CMAKE_${kind}_LINKER_FLAGS_PUBLISH "${CMAKE_${kind}_LINKER_FLAGS_RELEASE}" CACHE STRING "Publish linker flags" FORCE)
endforeach()
set(CMAKE_MAP_IMPORTED_CONFIG_PUBLISH Release)
