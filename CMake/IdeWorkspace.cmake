function(ursa_include_csharp_project name path guid folder)
  include_external_msproject("${name}" "${path}"
    TYPE "{9A19103F-16F7-4668-BE54-9A1E7A4F7556}" GUID "${guid}" PLATFORM "Any CPU")
  set_target_properties("${name}" PROPERTIES FOLDER "${folder}")
  # ProjectReference builds framework dependencies once for IDE checks. Native
  # targets retain the separate formal framework build and output directories.
  set_target_properties("${name}" PROPERTIES MAP_IMPORTED_CONFIG_RELWITHDEBINFO Debug MAP_IMPORTED_CONFIG_MINSIZEREL Release)
endfunction()

function(ursa_configure_ide_workspace)
  if(NOT URSA_ENABLE_DOTNET OR NOT CMAKE_GENERATOR STREQUAL "Visual Studio 18 2026")
    return()
  endif()
  include("${URSA_SOURCE_ROOT}/CMake/WorkspacePython.cmake")
  ursa_find_workspace_python()
  file(GLOB_RECURSE ideInputs CONFIGURE_DEPENDS
    "${URSA_SOURCE_ROOT}/Managed/*.cs" "${URSA_SOURCE_ROOT}/Managed/*.csproj"
    "${URSA_SOURCE_ROOT}/Managed/*.props" "${URSA_SOURCE_ROOT}/Managed/*.targets")
  if(URSA_BUILD_TESTS)
    file(GLOB_RECURSE testIdeInputs CONFIGURE_DEPENDS "${URSA_SOURCE_ROOT}/Tests/Managed/*.cs" "${URSA_SOURCE_ROOT}/Tests/Managed/*.csproj")
    list(APPEND ideInputs ${testIdeInputs})
    set(testFlag --include-tests)
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${URSA_SOURCE_ROOT}/Tools/GenerateManagedIde.py" "${URSA_SOURCE_ROOT}/Tools/WorkspaceCommon.py" ${ideInputs})
  execute_process(COMMAND "${URSA_WORKSPACE_PYTHON}" "${URSA_SOURCE_ROOT}/Tools/GenerateManagedIde.py"
    --engine-root "${URSA_SOURCE_ROOT}" --build-root "${URSA_BINARY_ROOT}"
    --roslyn-directory "${URSA_ROSLYN_DIRECTORY}" --project-directory "${URSA_PROJECT_DIR}" ${testFlag}
    COMMAND_ERROR_IS_FATAL ANY)
  file(READ "${URSA_BINARY_ROOT}/Ide/Managed/Projects.json" projects)
  string(JSON count LENGTH "${projects}")
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    foreach(key IN ITEMS name path guid folder)
      string(JSON ${key} GET "${projects}" ${index} ${key})
    endforeach()
    ursa_include_csharp_project("${name}" "${path}" "${guid}" "${folder}")
  endforeach()
  if(URSA_BUILD_EDITOR AND NOT URSA_PROJECT_DIR STREQUAL "")
    set(projectIde "${URSA_PROJECT_DIR}/Library/ScriptIDE/Projects")
    if(NOT URSA_WORKSPACE_BOOTSTRAP)
      if(NOT EXISTS "${projectIde}/Game/Ursa.Game.csproj" OR NOT EXISTS "${projectIde}/Editor/Ursa.EditorScripts.csproj")
        message(FATAL_ERROR "Project IDE files are missing. Run GenerateEngineSolutionWithTracy.bat (or Tools/GenerateSolution.bat) to bootstrap the unified workspace.")
      endif()
      get_filename_component(projectName "${URSA_PROJECT_DIR}" NAME)
      ursa_include_csharp_project(Ursa.Game "${projectIde}/Game/Ursa.Game.csproj" "61019740-4D72-4E51-A436-86CE4B2B2B3F" "Projects/${projectName}")
      ursa_include_csharp_project(Ursa.EditorScripts "${projectIde}/Editor/Ursa.EditorScripts.csproj" "9F915667-BBDA-4FDC-93B8-06253CB36992" "Projects/${projectName}")
    endif()
    set(ready true)
    if(URSA_WORKSPACE_BOOTSTRAP)
      set(ready false)
    endif()
    set(description "{\n  \"Version\":1,\n  \"Ready\":${ready},\n  \"EngineRoot\":\"${URSA_SOURCE_ROOT}\",\n  \"BuildRoot\":\"${URSA_BINARY_ROOT}\",\n  \"Solution\":\"${URSA_BINARY_ROOT}/UrsaEngine.slnx\",\n  \"ProjectRoot\":\"${URSA_PROJECT_DIR}\",\n  \"ManagedProjects\":\"${URSA_BINARY_ROOT}/Ide/Managed\",\n  \"Configurations\":[\"Debug\",\"Release\"]\n}\n")
    set(descriptionPath "${URSA_BINARY_ROOT}/UnifiedWorkspace.json")
    set(previous "")
    if(EXISTS "${descriptionPath}")
      file(READ "${descriptionPath}" previous)
    endif()
    if(NOT previous STREQUAL description)
      file(WRITE "${descriptionPath}.tmp" "${description}")
      file(RENAME "${descriptionPath}.tmp" "${descriptionPath}")
    endif()
  endif()
endfunction()
