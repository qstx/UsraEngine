Shader "Ursa/Universal/Unlit"
{
	Properties
	{
		_BaseColor ("Base Color", Color) = (1, 1, 1, 1)
		_AlphaMode ("Alpha Mode", Int) = 0
		_AlphaCutoff ("Alpha Cutoff", Range(0, 1)) = 0.5
		_BaseMap ("Base Map", 2D) = "white" {}
	}
	HLSLINCLUDE
#include "../ShaderLibrary/Core.hlsl"

cbuffer UrsaPerMaterial
{
	float4 _BaseColor;
	int _AlphaMode;
	float _AlphaCutoff;
}

TEXTURE2D(_BaseMap);
SAMPLER(sampler_BaseMap);

float4 UrsaSampleUnlit(float2 uv)
{
	return SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, uv) * _BaseColor;
}

void UrsaUnlitAlphaClip(float2 uv)
{
	if (_AlphaMode == 1 && UrsaSampleUnlit(uv).a < _AlphaCutoff)
		discard;
}

#define URSA_SHADOW_ALPHA_CLIP(uv) UrsaUnlitAlphaClip(uv)
#define URSA_DEPTH_ALPHA_CLIP(uv) UrsaUnlitAlphaClip(uv)
ENDHLSL
	SubShader
	{
		Tags { "RenderPipeline" = "UrsaUniversal" }
		Pass
		{
			Name "Forward"
			Tags { "LightMode" = "UniversalForward" }
			Cull Back
			ZWrite On
			ZTest LEqual
			HLSLPROGRAM
#pragma vertex UrsaUnlitVertex
#pragma fragment UrsaUnlitFragment
struct UrsaUnlitAttributes
{
	float3 positionOS : POSITION;
	float3 normalOS : NORMAL;
	float2 uv : TEXCOORD0;
	uint4 joints : BLENDINDICES;
	float4 weights : BLENDWEIGHT;
};

struct UrsaUnlitVaryings
{
	float4 positionCS : SV_Position;
	float2 uv : TEXCOORD0;
};

UrsaUnlitVaryings UrsaUnlitVertex(UrsaUnlitAttributes input)
{
	UrsaUnlitVaryings output;
	float4x4 skin = UrsaGetSkinMatrix(input.joints, input.weights);
	output.positionCS = UrsaTransformObjectToHClip(UrsaSkinPosition(input.positionOS, skin));
	output.uv = input.uv;
	return output;
}

float4 UrsaUnlitFragment(UrsaUnlitVaryings input) : SV_Target0
{
	float4 color = UrsaSampleUnlit(input.uv);
	if (_AlphaMode == 1 && color.a < _AlphaCutoff) discard;
	return float4(color.rgb, _AlphaMode == 2 ? color.a : 1.0);
}
ENDHLSL
		}
		Pass
		{
			Name "ShadowCaster"
			Tags { "LightMode" = "ShadowCaster" }
			Cull Back
			ZWrite On
			ZTest LEqual
			HLSLPROGRAM
#pragma vertex UrsaShadowCasterVertex
#pragma fragment UrsaShadowCasterFragment
#include "../Passes/ShadowCasterPass.hlsl"
ENDHLSL
		}
		Pass
		{
			Name "DepthOnly"
			Tags { "LightMode" = "DepthOnly" }
			Cull Back
			ZWrite On
			ZTest LEqual
			HLSLPROGRAM
#pragma vertex UrsaDepthOnlyVertex
#pragma fragment UrsaDepthOnlyFragment
#include "../Passes/DepthOnlyPass.hlsl"
ENDHLSL
		}
		Pass
		{
			Name "DepthNormals"
			Tags { "LightMode" = "DepthNormals" }
			Cull Back
			ZWrite On
			ZTest LEqual
			HLSLPROGRAM
#pragma vertex UrsaDepthNormalsVertex
#pragma fragment UrsaDepthNormalsFragment
#include "../Passes/DepthNormalsPass.hlsl"
ENDHLSL
		}
	}
}
