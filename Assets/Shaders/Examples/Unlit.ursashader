Shader "Ursa/Examples/Unlit"
{
	Properties
	{
		_Tint ("Tint", Color) = (1, 1, 1, 1)
		[NoScaleOffset] _BaseMap ("Base Map", 2D) = "white" {}
	}
	HLSLINCLUDE
#include "../ShaderLibrary/Core.hlsl"
cbuffer MaterialData
{
	float4 _Tint;
}
TEXTURE2D(_BaseMap);
SAMPLER(sampler_BaseMap);
ENDHLSL
	SubShader
	{
		Tags { "RenderPipeline" = "UrsaUniversal" }
		Pass
		{
			Name "Forward"
			Tags { "LightMode" = "UniversalForward" }
			Cull Back
			ZWrite On
			ZTest LEqual
			HLSLPROGRAM
#pragma vertex VSMain
#pragma fragment PSMain
struct VertexOutput
{
	float4 position : SV_Position;
	float2 uv : TEXCOORD0;
};
VertexOutput VSMain(float3 position : POSITION, float2 uv : TEXCOORD0)
{
	VertexOutput output;
	output.position = UrsaTransformObjectToHClip(position);
	output.uv = uv;
	return output;
}
float4 PSMain(VertexOutput input) : SV_Target0
{
	return SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, input.uv) * _Tint;
}
ENDHLSL
		}
	}
	Fallback "Ursa/Error"
}
