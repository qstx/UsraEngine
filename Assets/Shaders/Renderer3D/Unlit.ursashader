Shader "Ursa/Unlit"
{
	ID "10000000-0000-4000-8000-000000000001"
	Version 1
	Properties
	{
		_BaseColor ("Base Color", Color) = (1, 1, 1, 1)
		_AlphaMode ("Alpha Mode", Int) = 0
		_AlphaCutoff ("Alpha Cutoff", Range(0, 1)) = 0.5
		_MainTex ("Base Map", 2D) = "white" {}
	}
	HLSLINCLUDE
cbuffer UrsaPerObject : register(b0)
{
	float4x4 _UrsaViewProjection;
	float4x4 _UrsaModel;
}
cbuffer MaterialData : register(b1)
{
	float4 _BaseColor;
	int _AlphaMode;
	float _AlphaCutoff;
}
Texture2D<float4> _MainTex : register(t0);
SamplerState sampler_MainTex : register(s0);
ENDHLSL
	SubShader
	{
		Tags { "RenderPipeline" = "UrsaForward" }
		Pass
		{
			Name "Forward"
			Tags { "LightMode" = "Forward" }
			Cull Back
			ZWrite On
			ZTest LEqual
			HLSLPROGRAM
#pragma vertex VSMain
#pragma fragment PSMain
struct VertexOutput
{
	float4 position : SV_Position;
	float2 uv : TEXCOORD0;
};
VertexOutput VSMain(float3 position : POSITION, float2 uv : TEXCOORD0)
{
	VertexOutput output;
	output.position = mul(_UrsaViewProjection, mul(_UrsaModel, float4(position, 1.0)));
	output.uv = uv;
	return output;
}
float4 PSMain(VertexOutput input) : SV_Target0
{
	float4 color = _MainTex.Sample(sampler_MainTex, input.uv) * _BaseColor;
	if (_AlphaMode == 1 && color.a < _AlphaCutoff)
	{
		discard;
	}
	float alpha = _AlphaMode == 2 ? color.a : 1.0;
	return float4(pow(max(color.rgb, 0.0), 1.0 / 2.2), alpha);
}
ENDHLSL
		}
	}
}
