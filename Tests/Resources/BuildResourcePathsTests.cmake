cmake_minimum_required(VERSION 3.20)
if(DEFINED CASE)
  set(PROJECT_SOURCE_DIR "${ENGINE_ROOT}")
  set(CMAKE_BINARY_DIR "${SCRATCH}/${CASE}")
  set(CMAKE_CONFIGURATION_TYPES Debug Release)
  if(CASE STREQUAL "legacy")
    set(URSA_ASSET_CACHE_DIR "${ENGINE_ROOT}/cache" CACHE PATH "")
    set(URSA_ASSET_MIRROR_DIR "${ENGINE_ROOT}/cache/assets" CACHE PATH "")
  elseif(CASE STREQUAL "custom")
    set(URSA_ASSET_CACHE_DIR "${SCRATCH}/CustomCache" CACHE PATH "")
  elseif(CASE STREQUAL "escape")
    set(URSA_ENGINE_RESOURCES_ROOT "${ENGINE_ROOT}/Assets" CACHE PATH "")
  elseif(CASE STREQUAL "overlap")
    set(URSA_ENGINE_RESOURCES_ROOT "${CMAKE_BINARY_DIR}/Resources" CACHE PATH "")
    set(URSA_SHADER_COMPILE_CACHE_DIR "${CMAKE_BINARY_DIR}/Resources/Cache" CACHE PATH "")
  endif()
  include("${ENGINE_ROOT}/Tools/BuildResourcePaths.cmake")
  ursa_configure_resource_paths()
  if(DEFINED URSA_ASSET_CACHE_DIR OR DEFINED URSA_ASSET_MIRROR_DIR)
    message(FATAL_ERROR "Legacy cache variables were not removed")
  endif()
  if(NOT URSA_ENGINE_RESOURCES_DIR STREQUAL "${CMAKE_BINARY_DIR}/Resources/$<CONFIG>" OR
     NOT URSA_SHADER_COMPILE_CACHE_DIR STREQUAL "${CMAKE_BINARY_DIR}/Intermediate/ShaderCompileCache")
    message(FATAL_ERROR "Build outputs do not belong to the selected binary tree")
  endif()
  return()
endif()
file(MAKE_DIRECTORY "${SCRATCH}/CustomCache")
file(WRITE "${SCRATCH}/CustomCache/Keep.txt" "user data")
foreach(testCase IN ITEMS default legacy custom escape overlap)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${testCase}" "-DENGINE_ROOT=${ENGINE_ROOT}"
    "-DSCRATCH=${SCRATCH}" -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(testCase STREQUAL "default" OR testCase STREQUAL "legacy")
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "${testCase} configuration failed: ${output}${errors}")
    endif()
  else()
    if(result STREQUAL "0")
      message(FATAL_ERROR "${testCase} configuration was incorrectly accepted")
    endif()
    if(testCase STREQUAL "custom" AND (NOT errors MATCHES "URSA_ASSET_CACHE_DIR" OR NOT errors MATCHES "custom path"))
      message(FATAL_ERROR "Custom legacy path did not produce the expected migration diagnostic: ${errors}")
    endif()
  endif()
endforeach()
file(READ "${SCRATCH}/CustomCache/Keep.txt" preserved)
if(NOT preserved STREQUAL "user data")
  message(FATAL_ERROR "Custom legacy cache data was modified")
endif()
message(STATUS "Build resource path migration tests passed")
