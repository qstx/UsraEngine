cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${SCRATCH}/Source")
file(COPY "${ENGINE_SOURCE}/" DESTINATION "${SCRATCH}/Source")
set(sourceRoot "${SCRATCH}/Source")
set(cacheRoot "${SCRATCH}/Intermediate/ShaderCompileCache")
set(debugRoot "${SCRATCH}/Resources/${TEST_CONFIGURATION}")
set(releaseRoot "${SCRATCH}/Resources/Release")
if(TEST_CONFIGURATION STREQUAL "Debug")
  set(otherConfiguration Release)
else()
  set(otherConfiguration Debug)
endif()
set(commonArguments "-DIMPORTER=${IMPORTER}" "-DSOURCE_ROOT=${sourceRoot}" "-DCACHE_ROOT=${cacheRoot}"
  "-DDXC=${DXC}" "-DSPIRV_VAL=${SPIRV_VAL}" "-DSPIRV_CROSS=${SPIRV_CROSS}")
set(managedArguments)
if(DEFINED MANAGED_ROOT AND NOT MANAGED_ROOT STREQUAL "")
  list(APPEND managedArguments "-DMANAGED_ROOT=${MANAGED_ROOT}")
endif()

function(prepare configuration expectSuccess)
  execute_process(COMMAND "${CMAKE_COMMAND}" ${commonArguments}
    "-DOUTPUT_ROOT=${SCRATCH}/Resources/${configuration}" "-DCONFIGURATION=${configuration}"
    ${managedArguments} -P "${ENGINE_ROOT}/Tools/PrepareResources.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(expectSuccess AND NOT result STREQUAL "0")
    message(FATAL_ERROR "Preparation failed: ${output}${errors}")
  elseif(NOT expectSuccess AND result STREQUAL "0")
    message(FATAL_ERROR "Invalid preparation succeeded")
  endif()
  set(lastPreparationOutput "${output}" PARENT_SCOPE)
endfunction()

prepare("${TEST_CONFIGURATION}" TRUE)
file(READ "${debugRoot}/BuildManifest.json" manifest)
string(JSON configuration GET "${manifest}" configuration)
if(NOT configuration STREQUAL "${TEST_CONFIGURATION}")
  message(FATAL_ERROR "Preparation used the wrong configuration")
endif()
set(shader "${debugRoot}/Shaders/Editor/ImGui.ursashaderasset")
file(SHA256 "${shader}" shaderHash)
file(TIMESTAMP "${debugRoot}/BuildManifest.json" originalTimestamp "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
prepare("${TEST_CONFIGURATION}" TRUE)
file(TIMESTAMP "${debugRoot}/BuildManifest.json" reusedTimestamp "%s")
if(NOT originalTimestamp STREQUAL reusedTimestamp OR NOT lastPreparationOutput MATCHES "resources are current")
  message(FATAL_ERROR "An unchanged preparation rewrote resources or did not reuse completion")
endif()
file(REMOVE "${shader}")
prepare("${TEST_CONFIGURATION}" TRUE)
file(SHA256 "${shader}" restoredHash)
if(NOT restoredHash STREQUAL shaderHash)
  message(FATAL_ERROR "Missing Shader was not restored correctly")
endif()
if(managedArguments)
  file(REMOVE "${debugRoot}/Managed/Ursa.Runtime.dll")
  prepare("${TEST_CONFIGURATION}" TRUE)
  if(NOT EXISTS "${debugRoot}/Managed/Ursa.Runtime.dll")
    message(FATAL_ERROR "Missing managed bootstrap was not restored")
  endif()
endif()

# This deletion is confined to the isolated test output subtree.
cmake_path(IS_PREFIX SCRATCH "${debugRoot}" NORMALIZE insideScratch)
if(NOT insideScratch OR debugRoot STREQUAL SCRATCH)
  message(FATAL_ERROR "Unsafe resource test deletion path")
endif()
file(REMOVE_RECURSE "${debugRoot}")
prepare("${TEST_CONFIGURATION}" TRUE)
if(NOT EXISTS "${shader}" OR NOT EXISTS "${debugRoot}/BuildManifest.json")
  message(FATAL_ERROR "Deleted runtime resource tree was not reconstructed")
endif()

set(package "${SCRATCH}/Content.pak")
function(package expectSuccess configuration root)
  execute_process(COMMAND "${PAK}" --engine "${sourceRoot}" --engine-generated "${root}"
    --configuration "${configuration}" --output "${package}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(expectSuccess AND NOT result STREQUAL "0")
    message(FATAL_ERROR "Package failed: ${output}${errors}")
  elseif(NOT expectSuccess AND result STREQUAL "0")
    message(FATAL_ERROR "Invalid engine package succeeded")
  endif()
endfunction()
package(TRUE "${TEST_CONFIGURATION}" "${debugRoot}")
file(SHA256 "${package}" packageHash)
package(FALSE "${otherConfiguration}" "${debugRoot}")
file(WRITE "${shader}" "corrupted bytes")
package(FALSE "${TEST_CONFIGURATION}" "${debugRoot}")
file(SHA256 "${package}" unchangedPackageHash)
if(NOT packageHash STREQUAL unchangedPackageHash)
  message(FATAL_ERROR "Rejected input replaced the previous complete package")
endif()
prepare("${TEST_CONFIGURATION}" TRUE)
file(APPEND "${sourceRoot}/README.md" "\nchanged input\n")
package(FALSE "${TEST_CONFIGURATION}" "${debugRoot}")
prepare("${TEST_CONFIGURATION}" TRUE)
package(TRUE "${TEST_CONFIGURATION}" "${debugRoot}")

set(sourceShader "${sourceRoot}/Shaders/Renderer3D/Unlit.ursashader")
file(READ "${sourceShader}" validSource)
file(SHA256 "${shader}" previousShaderHash)
file(WRITE "${sourceShader}" "Shader invalid")
prepare("${TEST_CONFIGURATION}" FALSE)
if(EXISTS "${debugRoot}/BuildManifest.json")
  message(FATAL_ERROR "Failed preparation left a successful completion manifest")
endif()
file(SHA256 "${shader}" retainedShaderHash)
if(NOT retainedShaderHash STREQUAL previousShaderHash)
  message(FATAL_ERROR "Failed import replaced a previous valid Shader")
endif()
file(WRITE "${sourceShader}" "${validSource}")
prepare("${TEST_CONFIGURATION}" TRUE)

# execute_process launches both commands concurrently. Neither consumes stdin;
# their small status messages fit the connecting pipe while the cache lock serializes writes.
execute_process(
  COMMAND "${CMAKE_COMMAND}" ${commonArguments} "-DOUTPUT_ROOT=${SCRATCH}/Parallel/Debug" -DCONFIGURATION=Debug
    -P "${ENGINE_ROOT}/Tools/PrepareResources.cmake"
  COMMAND "${CMAKE_COMMAND}" ${commonArguments} "-DOUTPUT_ROOT=${SCRATCH}/Parallel/Release" -DCONFIGURATION=Release
    -P "${ENGINE_ROOT}/Tools/PrepareResources.cmake"
  RESULTS_VARIABLE results OUTPUT_VARIABLE output ERROR_VARIABLE errors)
foreach(result IN LISTS results)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Concurrent resource preparation failed: ${output}${errors}")
  endif()
endforeach()
file(READ "${SCRATCH}/Parallel/Release/BuildManifest.json" manifest)
string(JSON configuration GET "${manifest}" configuration)
if(NOT configuration STREQUAL "Release")
  message(FATAL_ERROR "Concurrent configurations published the wrong completion data")
endif()
package(TRUE Release "${SCRATCH}/Parallel/Release")
message(STATUS "Build resource recovery, failure, packaging and concurrency tests passed")
