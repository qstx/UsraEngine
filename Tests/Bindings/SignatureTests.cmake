foreach(required IN ITEMS URSA_SOURCE_ROOT PROBE_ROOT BINDINGS_GENERATOR DOTNET_EXECUTABLE PROBE_GENERATOR)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
file(READ "${URSA_SOURCE_ROOT}/Tests/Bindings/Contracts/Fixture.bindings.cs" contract)
file(READ "${URSA_SOURCE_ROOT}/Tests/Bindings/Contracts/Values.cs" values)
string(REPLACE "BindingFixture.hpp" "SignatureTarget.hpp" contract "${contract}")
string(REPLACE "Ursa::Tests::BindingFixture::Add" "Ursa::Tests::SignatureTarget::Add" contract "${contract}")
foreach(variant IN ITEMS Valid Missing ReturnType ParameterType)
  set(probe "${PROBE_ROOT}/${variant}")
  file(MAKE_DIRECTORY "${probe}/Contracts")
  file(WRITE "${probe}/Contracts/Fixture.bindings.cs" "${contract}")
  file(WRITE "${probe}/Contracts/Values.cs" "${values}")
  set(target "")
  if(variant STREQUAL "Valid")
    set(target "inline Result<Int64> Add(BindingCall&, Int64 a, Int64 b) { return Result<Int64>::Success(a+b); }")
  elseif(variant STREQUAL "ReturnType")
    set(target "inline Result<Int32> Add(BindingCall&, Int64, Int64) { return Result<Int32>::Success(1); }")
  elseif(variant STREQUAL "ParameterType")
    set(target "inline Result<Int64> Add(BindingCall&, UInt64, Int64) { return Result<Int64>::Success(1); }")
  endif()
  file(WRITE "${probe}/SignatureTarget.hpp"
    "#include <BindingFixture.hpp>\nnamespace Ursa::Tests::SignatureTarget { using namespace Scripting::Bindings; ${target} }\n")
  execute_process(COMMAND "${DOTNET_EXECUTABLE}" "${BINDINGS_GENERATOR}"
    --input "${probe}/Contracts" --output "${probe}/Generated"
    --source "${URSA_SOURCE_ROOT}/Managed/Ursa.Runtime/MathValues.cs"
    RESULT_VARIABLE generated OUTPUT_VARIABLE generatedOutput ERROR_VARIABLE generatedError)
  if(NOT generated EQUAL 0)
    message(FATAL_ERROR "Probe generation failed: ${generatedOutput}${generatedError}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${URSA_SOURCE_ROOT}/Tests/Bindings/Signature"
    -B "${probe}/Build" -G "${PROBE_GENERATOR}" -A x64
    "-DURSA_SOURCE_ROOT=${URSA_SOURCE_ROOT}" "-DBINDING_PROBE_ROOT=${probe}"
    RESULT_VARIABLE configured OUTPUT_VARIABLE configureOutput ERROR_VARIABLE configureError)
  if(NOT configured EQUAL 0)
    message(FATAL_ERROR "Probe configure failed: ${configureOutput}${configureError}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${probe}/Build" --config Release -- /m:1 /nodeReuse:false
    RESULT_VARIABLE compiled OUTPUT_VARIABLE buildOutput ERROR_VARIABLE buildError)
  if(variant STREQUAL "Valid")
    if(NOT compiled EQUAL 0)
      message(FATAL_ERROR "Valid native target failed to compile: ${buildOutput}${buildError}")
    endif()
  else()
    if(compiled EQUAL 0)
      message(FATAL_ERROR "Invalid native target ${variant} compiled successfully")
    endif()
    if(NOT "${buildOutput}${buildError}" MATCHES "Fixture.bindings.cs")
      message(FATAL_ERROR "Native diagnostic did not map to the binding declaration: ${buildOutput}${buildError}")
    endif()
    if(NOT variant STREQUAL "Missing" AND NOT "${buildOutput}${buildError}" MATCHES "Native binding target signature mismatch")
      message(FATAL_ERROR "Native diagnostic missed exact-signature validation: ${buildOutput}${buildError}")
    endif()
  endif()
endforeach()
message(STATUS "Native target existence, return and exact parameter signatures verified")
