<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Managed/Ursa.Bindings/Ursa.Bindings.csproj" />
    <Compile Include="../Contracts/*.cs" Link="Contracts/%(Filename)%(Extension)" />
    <Compile Include="../../../Managed/Ursa.Runtime/MathValues.cs" Link="MathValues.cs" />
    <Compile Include="$(BindingsGeneratedDir)/*.cs" Link="Generated/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
