function(ursa_add_test_executable target entry)
  file(GLOB headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*.hpp"
    "${CMAKE_CURRENT_SOURCE_DIR}/*.h" "${CMAKE_CURRENT_SOURCE_DIR}/*.inl")
  add_executable(${target} "${entry}" ${headers})
  set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${URSA_BINARY_ROOT}/$<CONFIG>")
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${entry}" source)
  if(source MATCHES "#include [<\"](ResourceFixtures|MeshFixtures|RenderingFixtures|AtomicFile)\\.hpp[>\"]")
    target_link_libraries(${target} PRIVATE UrsaTestFixtures)
  endif()
endfunction()

function(ursa_test_shader target source)
  target_sources(${target} PRIVATE "${source}")
  set_source_files_properties("${source}" PROPERTIES HEADER_FILE_ONLY TRUE)
endfunction()

# Apply test metadata in its registration directory, not in the root directory.
function(ursa_finalize_test_directory)
  file(RELATIVE_PATH folder "${URSA_SOURCE_ROOT}" "${CMAKE_CURRENT_SOURCE_DIR}")
  get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    ursa_source_groups(${target} "${folder}")
  endforeach()
  get_property(tests DIRECTORY PROPERTY TESTS)
  foreach(test IN LISTS tests)
    set_property(TEST ${test} APPEND PROPERTY LABELS "${folder}")
    set_property(TEST ${test} PROPERTY WORKING_DIRECTORY "${URSA_BINARY_ROOT}")
  endforeach()
endfunction()

function(ursa_require_test_content test target)
  if(TARGET UrsaAssetImport)
    set_property(TEST ${test} APPEND PROPERTY FIXTURES_REQUIRED UrsaTestContent)
    set_property(TEST ${test} APPEND PROPERTY ENVIRONMENT "URSA_CONTENT_PROJECT=${URSA_TEST_CONTENT_PROJECT}")
    if(TARGET ${target})
      add_dependencies(${target} UrsaAssetImport)
    endif()
  endif()
endfunction()

function(ursa_require_sample_project test target)
  if(TARGET UrsaAssetImport AND NOT URSA_PROJECT_DIR STREQUAL "")
    set_property(TEST ${test} APPEND PROPERTY FIXTURES_REQUIRED UrsaTestSample)
    set_property(TEST ${test} APPEND PROPERTY RESOURCE_LOCK UrsaSampleProject)
    if(TARGET ${target})
      add_dependencies(${target} UrsaAssetImport)
    endif()
  endif()
endfunction()
