cmake_minimum_required(VERSION 4.4.5)
if(DEFINED CASE)
  set(URSA_SOURCE_ROOT "${SCRATCH}/Engine checkout")
  if(CASE STREQUAL "explicit")
    set(URSA_ENGINE_DIR "${URSA_SOURCE_ROOT}/./" CACHE PATH "")
    set(URSA_PROJECT_DIR "${SCRATCH}/Project with spaces/../Project with spaces" CACHE PATH "")
  elseif(CASE STREQUAL "wrong-engine")
    set(URSA_ENGINE_DIR "${SCRATCH}/Other engine" CACHE PATH "")
  elseif(CASE STREQUAL "missing-engine")
    set(URSA_ENGINE_DIR "${SCRATCH}/Missing engine" CACHE PATH "")
  elseif(CASE STREQUAL "missing-project")
    set(URSA_PROJECT_DIR "${SCRATCH}/Missing project" CACHE PATH "")
  elseif(CASE STREQUAL "missing-assets")
    set(URSA_PROJECT_DIR "${SCRATCH}/Other engine" CACHE PATH "")
  elseif(CASE STREQUAL "assets-file")
    set(URSA_PROJECT_DIR "${SCRATCH}/Assets file project" CACHE PATH "")
  endif()
  include("${ENGINE_ROOT}/CMake/DevelopmentPaths.cmake")
  if(NOT URSA_ENGINE_DIR STREQUAL URSA_SOURCE_ROOT)
    message(FATAL_ERROR "Engine path was not normalized: ${URSA_ENGINE_DIR}")
  endif()
  if(CASE STREQUAL "explicit")
    if(NOT URSA_PROJECT_DIR STREQUAL "${SCRATCH}/Project with spaces")
      message(FATAL_ERROR "Project path was not normalized: ${URSA_PROJECT_DIR}")
    endif()
    get_property(cached CACHE URSA_PROJECT_DIR PROPERTY VALUE)
    if(NOT cached STREQUAL URSA_PROJECT_DIR)
      message(FATAL_ERROR "Cache retained an unnormalized project path")
    endif()
  elseif(NOT URSA_PROJECT_DIR STREQUAL "")
    message(FATAL_ERROR "Default unexpectedly associated a project")
  endif()
  return()
endif()

file(MAKE_DIRECTORY "${SCRATCH}/Engine checkout" "${SCRATCH}/Other engine"
  "${SCRATCH}/Project with spaces/Assets" "${SCRATCH}/Assets file project")
file(WRITE "${SCRATCH}/Assets file project/Assets" "keep user data")
foreach(testCase IN ITEMS default explicit wrong-engine missing-engine missing-project missing-assets assets-file)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${testCase}" "-DENGINE_ROOT=${ENGINE_ROOT}"
    "-DSCRATCH=${SCRATCH}" -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(testCase STREQUAL "default" OR testCase STREQUAL "explicit")
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "${testCase} failed: ${output}${errors}")
    endif()
  elseif(result STREQUAL "0")
    message(FATAL_ERROR "${testCase} was incorrectly accepted")
  elseif(testCase MATCHES "engine" AND NOT errors MATCHES "URSA_ENGINE_DIR")
    message(FATAL_ERROR "${testCase} did not identify the engine setting: ${errors}")
  elseif(NOT testCase MATCHES "engine" AND NOT errors MATCHES "URSA_PROJECT_DIR")
    message(FATAL_ERROR "${testCase} did not identify the project setting: ${errors}")
  endif()
endforeach()
file(READ "${SCRATCH}/Assets file project/Assets" preserved)
if(NOT preserved STREQUAL "keep user data")
  message(FATAL_ERROR "Invalid project contents were modified")
endif()
message(STATUS "Engine/project path defaults, normalization, source identity and rejection cases passed")
