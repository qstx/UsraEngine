# Test fixtures are explicit execution steps, never dependencies of compilation.
file(TO_CMAKE_PATH "${PROJECT}" project_path)
get_filename_component(configuration "${PROJECT}" NAME)
if(NOT project_path MATCHES "/TestProjects/Runtime/${configuration}$")
  message(FATAL_ERROR "Refusing to clear a non-test content Library directory: ${project_path}")
endif()
file(REMOVE_RECURSE "${PROJECT}/Library")
file(MAKE_DIRECTORY "${PROJECT}/Assets")
execute_process(COMMAND "${IMPORTER}" --project "${PROJECT}" --configuration "${CONFIGURATION}" --no-scripts
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Test project import failed")
endif()
if(NOT EXISTS "${GLSLC}")
  message(FATAL_ERROR "GPU test fixture requires glslc; install the Vulkan SDK or set URSA_GLSLC_EXECUTABLE")
endif()
file(MAKE_DIRECTORY "${PROJECT}/Library/TestShaders")
file(GLOB shaders "${SHADER_SOURCES}/*.vert" "${SHADER_SOURCES}/*.frag" "${SHADER_SOURCES}/*.comp")
foreach(shader IN LISTS shaders)
  get_filename_component(name "${shader}" NAME)
  file(SHA256 "${shader}" fingerprint)
  set(output "${PROJECT}/Library/TestShaders/${name}.spv")
  set(previous "")
  if(EXISTS "${output}.input")
    file(READ "${output}.input" previous)
  endif()
  if(NOT EXISTS "${output}" OR NOT previous STREQUAL fingerprint)
    execute_process(COMMAND "${GLSLC}" "${shader}" -o "${output}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Test Shader import failed: ${shader}")
    endif()
    file(WRITE "${output}.input" "${fingerprint}")
  endif()
endforeach()
