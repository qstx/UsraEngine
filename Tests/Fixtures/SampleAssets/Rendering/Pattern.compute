#pragma kernel GeneratePattern
[[vk::image_format("rgba8")]] RWTexture2D<float4> _Output;

[numthreads(8, 8, 1)]
void GeneratePattern(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= 64 || id.y >= 64) return;
	float2 uv = (float2(id.xy) + 0.5) / 64.0;
	float grid = ((id.x / 8 + id.y / 8) & 1) ? 0.65 : 1.0;
	_Output[id.xy] = float4(grid, 0.5 + 0.5 * uv.x, 0.5 + 0.5 * uv.y, 1);
}
