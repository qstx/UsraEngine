if(NOT DEFINED BUILD_ROOT OR NOT DEFINED PROJECT)
  message(FATAL_ERROR "Sample preparation requires the configured build root and project path")
endif()
file(REAL_PATH "${BUILD_ROOT}" build_root)
file(REAL_PATH "${PROJECT}" project_path)
set(sample_root "${build_root}/TestProjects/Sample")
file(RELATIVE_PATH configuration "${sample_root}" "${project_path}")
cmake_path(IS_PREFIX sample_root "${project_path}" NORMALIZE in_sample_root)
if(NOT in_sample_root OR NOT configuration MATCHES "^[A-Za-z0-9_-]+$")
  message(FATAL_ERROR "Refusing to clear a non-test sample project: ${project_path}")
endif()
foreach(folder IN ITEMS Assets Library)
  file(REAL_PATH "${project_path}/${folder}" clear_path)
  cmake_path(IS_PREFIX project_path "${clear_path}" NORMALIZE inside_project)
  if(NOT inside_project OR clear_path STREQUAL project_path)
    message(FATAL_ERROR "Refusing to clear an escaped sample directory: ${clear_path}")
  endif()
  file(REMOVE_RECURSE "${clear_path}")
endforeach()
file(MAKE_DIRECTORY "${project_path}/Assets")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_directory
  "${CMAKE_CURRENT_LIST_DIR}/SampleAssets" "${project_path}/Assets" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not copy Engine sample test fixtures")
endif()
if(PREPARE_ONLY)
  return()
endif()
execute_process(COMMAND "${IMPORTER}" --project "${project_path}" --configuration "${CONFIGURATION}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Sample project import failed")
endif()
