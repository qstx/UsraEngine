execute_process(COMMAND "${TEST_EXE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "CPU capture tests failed: ${output}${errors}")
endif()
foreach(variant IN ITEMS missing negative zero duplicate unavailable unicode)
  if(variant STREQUAL "missing")
    set(arguments --pid)
  elseif(variant STREQUAL "negative")
    set(arguments --pid -1 --output unused.png)
  elseif(variant STREQUAL "zero")
    set(arguments --pid 1 --output unused.png --timeout-ms 0)
  elseif(variant STREQUAL "duplicate")
    set(arguments --pid 1 --pid 2 --output unused.png)
  elseif(variant STREQUAL "unicode")
    set(arguments --pid 4294967295 --output "中文 截图.png" --timeout-ms 50)
  else()
    set(arguments --pid 4294967295 --output unused.png --timeout-ms 50)
  endif()
  execute_process(COMMAND "${CLI}" ${arguments} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 3 ENCODING UTF-8)
  if(NOT result STREQUAL "1" OR errors STREQUAL "")
    message(FATAL_ERROR "CLI ${variant} did not fail with diagnostics: ${result} ${output}${errors}")
  endif()
  string(JSON status ERROR_VARIABLE invalid GET "${output}" Status)
  if(invalid OR status STREQUAL "Success")
    message(FATAL_ERROR "CLI ${variant} did not return one JSON failure: ${output}")
  endif()
  if(variant STREQUAL "unicode")
    string(JSON savedPath GET "${output}" Output)
    if(NOT savedPath MATCHES "中文 截图.png$")
      message(FATAL_ERROR "CLI did not preserve UTF-8 output path: ${output}")
    endif()
  endif()
endforeach()
execute_process(COMMAND "${CLI}" --help RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result STREQUAL "0" OR NOT output MATCHES "--timeout-ms" OR NOT errors STREQUAL "")
  message(FATAL_ERROR "Capture CLI help failed: ${output}${errors}")
endif()
message(STATUS "Capture protocol, lifecycle, deadlines and CLI arguments verified")
