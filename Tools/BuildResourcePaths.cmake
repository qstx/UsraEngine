# Migrate known defaults without creating, deleting or moving content.
function(ursa_configure_resource_paths)
  foreach(variable IN ITEMS URSA_ASSET_CACHE_DIR URSA_ASSET_MIRROR_DIR URSA_ENGINE_RESOURCES_ROOT URSA_SHADER_COMPILE_CACHE_DIR)
    if(DEFINED ${variable})
      get_filename_component(path "${${variable}}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
      cmake_path(NORMAL_PATH path)
      set(defaults "${PROJECT_SOURCE_DIR}/cache" "${PROJECT_SOURCE_DIR}/cache/Assets" "${CMAKE_BINARY_DIR}/Resources" "${CMAKE_BINARY_DIR}/Intermediate/ShaderCompileCache")
      set(known FALSE)
      foreach(default IN LISTS defaults)
        cmake_path(NORMAL_PATH default)
        if(WIN32)
          string(TOLOWER "${path}" checked)
          string(TOLOWER "${default}" expected)
        else()
          set(checked "${path}")
          set(expected "${default}")
        endif()
        if(checked STREQUAL expected)
          set(known TRUE)
        endif()
      endforeach()
      if(NOT known)
        message(FATAL_ERROR "Legacy ${variable} uses a custom path: ${path}. Remove this option with -U${variable}; run UrsaAssetImport --project <project>. Imported content now belongs to that project's Library. No data has been deleted.")
      endif()
      unset(${variable} CACHE)
      unset(${variable} PARENT_SCOPE)
      message(STATUS "Removed obsolete ${variable}; project imports now use Library")
    endif()
  endforeach()
endfunction()
