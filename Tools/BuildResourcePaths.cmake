# Build products belong to the binary tree; project imports belong to Library.
function(ursa_resource_real_path input output)
  set(ancestor "${input}")
  set(suffix "")
  while(NOT EXISTS "${ancestor}")
    get_filename_component(component "${ancestor}" NAME)
    get_filename_component(parent "${ancestor}" DIRECTORY)
    if(parent STREQUAL ancestor)
      break()
    endif()
    set(suffix "${component}/${suffix}")
    set(ancestor "${parent}")
  endwhile()
  file(REAL_PATH "${ancestor}" resolved)
  cmake_path(APPEND resolved "${suffix}")
  cmake_path(NORMAL_PATH resolved)
  set(${output} "${resolved}" PARENT_SCOPE)
endfunction()

function(ursa_configure_resource_paths)
  if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE)
    message(FATAL_ERROR "Choose CMAKE_BUILD_TYPE (for example Debug or Release) for engine resources")
  endif()
  set(configurations "${CMAKE_CONFIGURATION_TYPES}")
  if(NOT configurations)
    set(configurations "${CMAKE_BUILD_TYPE}")
  endif()
  foreach(configuration IN LISTS configurations)
    if(NOT configuration MATCHES "^[A-Za-z0-9][A-Za-z0-9_-]*$")
      message(FATAL_ERROR "Invalid resource configuration name: ${configuration}")
    endif()
  endforeach()
  set(legacyRoot "${PROJECT_SOURCE_DIR}/cache")
  foreach(legacyVariable IN ITEMS URSA_ASSET_CACHE_DIR URSA_ASSET_MIRROR_DIR)
    if(DEFINED ${legacyVariable})
      get_filename_component(oldPath "${${legacyVariable}}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
      if(legacyVariable STREQUAL "URSA_ASSET_CACHE_DIR")
        set(expectedPath "${legacyRoot}")
      else()
        set(expectedPath "${legacyRoot}/Assets")
      endif()
      cmake_path(NORMAL_PATH oldPath)
      cmake_path(NORMAL_PATH expectedPath)
      if(WIN32)
        string(TOLOWER "${oldPath}" oldPath)
        string(TOLOWER "${expectedPath}" expectedPath)
      endif()
      if(NOT oldPath STREQUAL expectedPath)
        message(FATAL_ERROR "Legacy ${legacyVariable}=${${legacyVariable}} is a custom path. Remove the legacy option (-U${legacyVariable}) and use URSA_ENGINE_RESOURCES_ROOT / URSA_SHADER_COMPILE_CACHE_DIR inside the build directory. No data has been deleted.")
      endif()
      unset(${legacyVariable} CACHE)
      unset(${legacyVariable} PARENT_SCOPE)
      message(STATUS "Migrated legacy ${legacyVariable} to build-owned resources")
    endif()
  endforeach()
  set(URSA_ENGINE_RESOURCES_ROOT "${CMAKE_BINARY_DIR}/Resources" CACHE PATH "Configuration-specific engine resources root")
  set(URSA_SHADER_COMPILE_CACHE_DIR "${CMAKE_BINARY_DIR}/Intermediate/ShaderCompileCache" CACHE PATH "Shared engine shader compiler cache")
  foreach(pathVariable IN ITEMS URSA_ENGINE_RESOURCES_ROOT URSA_SHADER_COMPILE_CACHE_DIR)
    get_filename_component(selectedPath "${${pathVariable}}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
    cmake_path(NORMAL_PATH selectedPath)
    ursa_resource_real_path("${CMAKE_BINARY_DIR}" buildRoot)
    ursa_resource_real_path("${selectedPath}" checkedPath)
    if(WIN32)
      string(TOLOWER "${buildRoot}" buildRoot)
      string(TOLOWER "${checkedPath}" checkedPath)
    endif()
    cmake_path(IS_PREFIX buildRoot "${checkedPath}" NORMALIZE insideBuild)
    if(NOT insideBuild OR checkedPath STREQUAL buildRoot)
      message(FATAL_ERROR "${pathVariable} must be a subdirectory of ${CMAKE_BINARY_DIR}: ${selectedPath}")
    endif()
    foreach(sourceArea IN ITEMS "${PROJECT_SOURCE_DIR}/Assets" "${URSA_PROJECT_DIR}/Assets" "${URSA_PROJECT_DIR}/Library")
      if(EXISTS "${sourceArea}")
        ursa_resource_real_path("${sourceArea}" checkedSource)
        if(WIN32)
          string(TOLOWER "${checkedSource}" checkedSource)
        endif()
        cmake_path(IS_PREFIX checkedSource "${checkedPath}" NORMALIZE sourceOverlap)
        cmake_path(IS_PREFIX checkedPath "${checkedSource}" NORMALIZE reverseSourceOverlap)
        if(sourceOverlap OR reverseSourceOverlap)
          message(FATAL_ERROR "${pathVariable} overlaps source assets or project Library: ${selectedPath}")
        endif()
      endif()
    endforeach()
    set(${pathVariable} "${selectedPath}" CACHE PATH "Build-owned engine output directory" FORCE)
    set(${pathVariable} "${selectedPath}" PARENT_SCOPE)
  endforeach()
  ursa_resource_real_path("${URSA_ENGINE_RESOURCES_ROOT}" resourceRoot)
  ursa_resource_real_path("${URSA_SHADER_COMPILE_CACHE_DIR}" cacheRoot)
  if(WIN32)
    string(TOLOWER "${resourceRoot}" resourceRoot)
    string(TOLOWER "${cacheRoot}" cacheRoot)
  endif()
  cmake_path(IS_PREFIX resourceRoot "${cacheRoot}" NORMALIZE overlapping)
  cmake_path(IS_PREFIX cacheRoot "${resourceRoot}" NORMALIZE reverseOverlapping)
  if(overlapping OR reverseOverlapping)
    message(FATAL_ERROR "Engine runtime resources and shader compilation cache must be separate")
  endif()
  set(URSA_ENGINE_RESOURCES_DIR "${URSA_ENGINE_RESOURCES_ROOT}/$<CONFIG>" PARENT_SCOPE)
endfunction()
